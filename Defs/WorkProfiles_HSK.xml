<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Профили для сборки Hardcore SK (ветка alpha, hcsk 1.6.4518).
    priority = 10: перекрывают ванильные профили (priority 0) для тех же видов работ.
    requiresMods: профиль действует, только если активен хотя бы один из модов.
    Статы, которых нет в игре, анализатор покажет в разделе «Проблемы профилей».
    NuclearWork (Rimatomics) пока использует запасной профиль: у него нет навыков, статы уточняются по отчёту.
  -->

  <!-- HSK: точный стат кузнечного дела вместо GeneralLaborSpeed. -->
  <HSKSmartWorkManager.WorkProfileDef>
    <defName>HSKSWM_HSK_Smithing</defName>
    <workType>Smithing</workType>
    <category>Primary</category>
    <skillWeight>0.6</skillWeight>
    <statWeight>0.4</statWeight>
    <priority>10</priority>
    <requiresMods>
      <li>skyarkhangel.hsk</li>
      <li>skyarkhangel.hsk.core</li>
    </requiresMods>
    <stats>
      <li><stat>SmithingSpeed</stat><weight>1</weight></li>
    </stats>
  </HSKSmartWorkManager.WorkProfileDef>

  <!-- HSK: точный стат шитья. -->
