      <li><stat>GeneralLaborSpeed</stat><weight>1</weight></li>
      <li><stat>StonecuttingSpeed</stat><weight>0.5</weight></li>
      <li><stat>ElectronicCraftingSpeed</stat><weight>0.5</weight></li>
      <li><stat>DrugSynthesisSpeed</stat><weight>0.25</weight></li>
    </stats>
  </HSKSmartWorkManager.WorkProfileDef>

